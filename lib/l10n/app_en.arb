  "introWelcome": "Welcome to Randnotiz",
  "introWelcomeBody": "A quiet photo diary for the stories behind your pictures.",
  "introLanguageTitle": "Your language",
  "introCloudCaption": "only for you",
  "introCloudTitle": "Your diary stays yours.",
  "introCloudBody": "What you write stays on this device – no account, no server of ours, no ads and no tracking. If you like, Randnotiz backs up your entries to a hidden app folder in your own Google Drive, end-to-end encrypted on this device first.",
  "introCloudKeys": "Only you hold the key: your backup password and the emergency key. Without them nobody can open the backup – not Google and not us, the developers. Keep both somewhere safe.",
  "introCloudQuestion": "Back up to your Google Drive?",
  "introCloudAfterTour": "You’ll set it up right after a short tour.",
  "introNoCloud": "Continue without backup",
  "introOnlineTitle": "When Randnotiz goes online",
  "introOnlineBody": "Weather and place search ask Open-Meteo – with a position rounded to about 1 km or with your search term. If you search for a song for an entry, the search term goes to Apple. When you dictate, Google’s speech recognition may listen, depending on the device; if you don’t want that, just type. What you type and your photos only leave the device encrypted – in your backup.",
  "introSetUpBackup": "Set up backup",
  "introHaveBackup": "I already have a backup",
  "introBackupUnavailable": "Backup isn’t available in this version.",
  "introPhotoCaption": "one photo",
  "introPhotoTitle": "One photo, one story.",
  "introPhotoBody": "Tap the photo with the plus at the bottom and pick a picture – from your phone or from Google Photos. Randnotiz doesn’t need access to your gallery for that.",
  "introWriteCaption": "in the margin",
  "introWriteTitle": "Write down how it felt.",
  "introWriteBody": "Who was there? What made you laugh? Write or dictate a few lines in the margin – everything saves by itself. Add a place, the weather, your mood or the song of the day if you like.",
  "introJournalCaption": "your journal",
  "introJournalTitle": "Page by page, your journal.",
  "introJournalBody": "Your entries collect like the pages of a notebook. Search for words, places or moods, gather trips into collections and watch your world map fill with colour.",
  "introMemoriesCaption": "a year ago",
  "introMemoriesTitle": "Your moments come back.",
  "introMemoriesBody": "On the anniversary, Randnotiz brings your moment back – in the app and, if you like, as a widget on your home screen.",
  "introLock": "If your device has a screen lock, Randnotiz opens only with your fingerprint, face or PIN – that’s on from the start. While it’s locked there are no screenshots and no preview in the app overview. The widget still shows a photo from your journal.",
  "introLockDebug": "In this development version, screenshots are still possible.",
  "introStart": "Let’s go",
  "introStartBackup": "Continue to backup",
  "introStartRestore": "Continue to restore",
  "introDemoTitle": "Picnic by the lake",
  "@introDemoTitle": {
    "description": "Sample entry in the introduction's animations"
  },
  "introDemoText": "Mia brought far too many strawberries. We stayed until the sun went down.",
  "introDemoPlace": "Lake Constance",
  "introDemoTitle2": "First snow",
  "introDemoTitle3": "Grandma’s birthday",
  "introDemoSearch": "lake",
  "settingsIntro": "View introduction",
  "settingsIntroSubtitle": "Language, backup and a short tour",
  "backupRestoreGuide": "Already have a backup? Connect the same Google account as on your previous device. Then enter your backup password or emergency key and bring your entries back.",
  "backupRestoreNoBackup": "There’s no Randnotiz backup in this Google account. If it’s in a different account, sign out and connect the right one.",
  "backupDevBanner": "Test app – shares the backup with the real app. Whatever you set up, back up or delete here affects the same backup in Google Drive.",
