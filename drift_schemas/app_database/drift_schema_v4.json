      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"asset_id\" TEXT NOT NULL UNIQUE, \"body\" TEXT NOT NULL DEFAULT '', \"note_date\" INTEGER NOT NULL, \"weather_kind\" TEXT NULL, \"temperature_c\" REAL NULL, \"place_name\" TEXT NULL, \"thumbnail_file\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
