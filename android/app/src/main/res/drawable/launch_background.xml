<?xml version="1.0" encoding="utf-8"?>
<!-- Start screen before Android 12: paper with the logo in the middle (the
     same size and place as the Android 12+ splash icon and the Flutter start
     screen that follows, so nothing jumps). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_logo"
        android:gravity="center" />
</layer-list>
